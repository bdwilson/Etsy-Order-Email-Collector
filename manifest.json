{
  "manifest_version": 3,
  "name": "Etsy Order Email Collector",
  "version": "2.1",
  "minimum_chrome_version": "111",
  "description": "Collect order IDs and email addresses from Etsy sold orders with optional LetterTrack integration",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://www.etsy.com/your/orders/sold*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.etsy.com/your/orders/sold*"],
      "js": ["etsyOrderParser.js", "pageHook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.etsy.com/your/orders/sold*"],
      "js": ["etsyOrderParser.js", "content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}